<UserControl x:Class="TaskManager.Controls.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             x:Name="Root"
             Loaded="Root_Loaded"
             MinHeight="32">

    <Border Background="{StaticResource VsCodeTitleBarBg}"
            BorderBrush="{StaticResource VsCodeBorderSubtle}"
            BorderThickness="0,0,0,1"
            Padding="0,2"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0,8,0">
                <TextBlock Text="{Binding TitleText, ElementName=Root}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Click="Min_Click"
                        Style="{StaticResource VsCodeIconButton}"
                        Width="28" Height="28"
                        Padding="2"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Свернуть">
                    <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14"/>
                </Button>
                <Button x:Name="MaxBtn"
                        Click="Max_Click"
                        Style="{StaticResource VsCodeIconButton}"
                        Width="28" Height="28"
                        Padding="2"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Развернуть">
                    <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="14" Height="14"/>
                </Button>
                <Button Click="Close_Click"
                        Style="{StaticResource VsCodeIconButton}"
                        Width="28" Height="28"
                        Padding="2"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Закрыть">
                    <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
