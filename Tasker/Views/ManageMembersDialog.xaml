<Window x:Class="TaskManager.Views.ManageMembersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:TaskManager.Controls"
        Title="Участники" Height="520" Width="620"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource TaskerChromeWindow}">

    <Grid Margin="{StaticResource AppPadHalfRem}" Background="{StaticResource VsCodeEditorBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" TitleText="Участники организации"/>

        <Border Grid.Row="1" Style="{StaticResource AppPanelStyle}" Margin="0,8,0,10">
            <StackPanel>
                <TextBlock Text="Добавить по email" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBox x:Name="EmailTextBox" materialDesign:HintAssist.Hint="Email" Margin="0,0,0,10"/>
                <ComboBox x:Name="TeamComboBox" DisplayMemberPath="Name"
                          materialDesign:HintAssist.Hint="Команда (опционально)" Margin="0,0,0,12"/>
                <Button Content="Добавить" Click="SendInvitation_Click"
                        Style="{StaticResource VsCodePrimaryButton}"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="Список" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox x:Name="MembersListBox" Style="{StaticResource StretchListBox}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,10"
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource VsCodePanelBg}"
                                BorderBrush="{StaticResource VsCodeBorder}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <StackPanel>
                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Email}" FontSize="12"
                                           Foreground="{StaticResource VsCodeForegroundMuted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Row="3"
                Background="{StaticResource VsCodeTitleBarBg}"
                BorderBrush="{StaticResource VsCodeBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="8,10"
                Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Профиль выбранного"
                        Click="OpenProfile_Click"
                        Margin="0,0,8,0"
                        Style="{StaticResource VsCodeSecondaryButton}"/>
                <Button Content="Закрыть"
                        Click="CloseButton_Click"
                        Style="{StaticResource VsCodePrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
