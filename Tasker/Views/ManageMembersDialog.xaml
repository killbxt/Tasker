<Window x:Class="TaskManager.Views.ManageMembersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Управление участниками" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">

        <Grid Margin="16" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление участниками" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- Добавление по email (без подтверждений) -->
        <Border Grid.Row="1" Style="{StaticResource AppPanelStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Добавить участника" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox x:Name="EmailTextBox" materialDesign:HintAssist.Hint="Email пользователя" Margin="0,0,0,8"/>
                <ComboBox x:Name="TeamComboBox" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Выбрать команду (опционально)" Margin="0,0,0,8"/>
                <Button Content="Добавить" Click="SendInvitation_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Border>

        <!-- Список участников -->
        <TextBlock Grid.Row="2" Text="Текущие участники" FontWeight="Bold" Margin="0,0,0,8"/>
        <ListBox Grid.Row="2" x:Name="MembersListBox" Margin="0,0,0,16" Grid.RowSpan="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="4" Background="{StaticResource AppPanelBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding Email}" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Профиль"
                    Click="OpenProfile_Click"
                    Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="Закрыть"
                    Click="CloseButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>
    </Grid>
</Window>