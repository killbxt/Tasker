<Window x:Class="TaskManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:dd="urn:gong-wpf-dragdrop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Tasker" Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource VsCodeEditorBg}"
        Foreground="{StaticResource VsCodeForeground}"
        FontFamily="Segoe UI"
        FontSize="13">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ColumnChrome" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource VsCodeSidebarBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VsCodeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Margin" Value="4,6"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="ColumnHeaderHost" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource VsCodePanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VsCodeBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <DataTemplate x:Key="TaskTemplate">
            <Border Background="{StaticResource VsCodePanelBg}"
                    BorderBrush="{StaticResource VsCodeBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Margin="6,4"
                    Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{Binding PriorityColor}" VerticalAlignment="Stretch"/>
                    <StackPanel Grid.Column="1" Margin="10,8,10,8">
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding Description}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource VsCodeForegroundMuted}"
                                   Margin="0,6,0,0"
                                   MaxHeight="60"/>

                        <Border Background="{StaticResource VsCodeBorder}" Height="1" Margin="0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <materialDesign:PackIcon Kind="CalendarClock" Width="14" Height="14"
                                                     Foreground="{StaticResource VsCodeForegroundMuted}"/>
                            <TextBlock Text="{Binding PlannedWindowText}"
                                       FontSize="12"
                                       Foreground="{StaticResource VsCodeForegroundMuted}"
                                       Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding DataContext.CanModifyTasks, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <Button Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource VsCodeIconButton}"
                                    ToolTip="Изменить">
                                <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"/>
                            </Button>
                            <Button Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource VsCodeIconButton}"
                                    ToolTip="Удалить">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource VsCodeEditorBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom title / toolbar (replaces системная шапка Windows) -->
        <Border Grid.Row="0"
                Background="{StaticResource VsCodeTitleBarBg}"
                BorderBrush="{StaticResource VsCodeBorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="6,4"
                MouseLeftButtonDown="ChromeBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Название + область слева; поиск отдельно по центру средней колонки -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tasker" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding TeamFilters}"
                              SelectedItem="{Binding SelectedTeamFilter}"
                              DisplayMemberPath="Name"
                              Width="180"
                              materialDesign:HintAssist.Hint="Область"
                              materialDesign:HintAssist.IsFloating="True"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>

                <!-- Высоту не фиксируем: у MaterialDesign Outlined иначе обрезается Hint -->
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Поиск"
                         materialDesign:HintAssist.IsFloating="True"
                         MinWidth="300"
                         Width="400"
                         MaxWidth="560"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding AddTaskCommand}" ToolTip="Новая задача"
                            Style="{StaticResource VsCodeIconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding CanModifyTasks, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding OpenProfileCommand}" ToolTip="Профиль"
                            Style="{StaticResource VsCodeIconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="AccountOutline" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding OpenAnalyticsCommand}" ToolTip="Аналитика"
                            Style="{StaticResource VsCodeIconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding CanUsePowerFeatures, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="ChartBar" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding OpenOverdueReportCommand}" ToolTip="Просрочки по организации (владелец)"
                            Style="{StaticResource VsCodeIconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding CanUsePowerFeatures, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="ClockAlertOutline" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding ManageTeamsCommand}" ToolTip="Организация и команды"
                            Style="{StaticResource VsCodeIconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="AccountGroupOutline" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding OpenAIChatCommand}" ToolTip="AI помощник"
                            Style="{StaticResource VsCodeIconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding CanUsePowerFeatures, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="RobotOutline" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding LogoutCommand}" ToolTip="Выйти"
                            Style="{StaticResource VsCodeIconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="Logout" Width="16" Height="16"/>
                    </Button>

                    <Border Width="1" Height="18" Background="{StaticResource VsCodeBorder}" Margin="8,0,4,0" VerticalAlignment="Center"/>

                    <Button Click="WindowMinimize_Click" ToolTip="Свернуть"
                            Style="{StaticResource VsCodeIconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Click="WindowMaximizeRestore_Click" ToolTip="Развернуть"
                            Style="{StaticResource VsCodeIconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon x:Name="MaximizeRestoreIcon" Kind="WindowMaximize" Width="16" Height="16"/>
                    </Button>
                    <Button Click="WindowClose_Click" ToolTip="Закрыть"
                            Style="{StaticResource VsCodeIconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Foreground="{StaticResource VsCodeForeground}">
                        <materialDesign:PackIcon Kind="WindowClose" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Kanban -->
        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TODO -->
            <Border x:Name="TodoColumn" Grid.Column="0" Style="{StaticResource ColumnChrome}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ColumnHeaderHost}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource VsCodeStripeTodo}"/>
                            <DockPanel Grid.Column="1" Margin="10,8,6,8" LastChildFill="True">
                                <TextBlock Text="{Binding TodoTasks.Count}" DockPanel.Dock="Right"
                                           Foreground="{StaticResource VsCodeForegroundMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Button Command="{Binding ClearTodoColumnCommand}" DockPanel.Dock="Right"
                                        Style="{StaticResource VsCodeIconButton}" ToolTip="Очистить колонку"
                                        Visibility="{Binding CanModifyTasks, Converter={StaticResource BoolToVis}}">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                </Button>
                                <TextBlock Text="Нужно сделать" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="Transparent"
                            AllowDrop="True"
                            dd:DragDrop.IsDropTarget="True"
                            dd:DragDrop.DropHandler="{Binding DropHandler}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,0">
                            <ItemsControl x:Name="TodoItemsControl"
                                          ItemsSource="{Binding TodoTasks}"
                                          ItemTemplate="{StaticResource TaskTemplate}"
                                          dd:DragDrop.IsDragSource="True"
                                          dd:DragDrop.UseDefaultDragAdorner="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- In progress -->
            <Border x:Name="InProgressColumn" Grid.Column="1" Style="{StaticResource ColumnChrome}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ColumnHeaderHost}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource VsCodeStripeProgress}"/>
                            <DockPanel Grid.Column="1" Margin="10,8,6,8" LastChildFill="True">
                                <TextBlock Text="{Binding InProgressTasks.Count}" DockPanel.Dock="Right"
                                           Foreground="{StaticResource VsCodeForegroundMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Button Command="{Binding ClearInProgressColumnCommand}" DockPanel.Dock="Right"
                                        Style="{StaticResource VsCodeIconButton}" ToolTip="Очистить колонку"
                                        Visibility="{Binding CanModifyTasks, Converter={StaticResource BoolToVis}}">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                </Button>
                                <TextBlock Text="В работе" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="Transparent"
                            AllowDrop="True"
                            dd:DragDrop.IsDropTarget="True"
                            dd:DragDrop.DropHandler="{Binding DropHandler}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,0">
                            <ItemsControl x:Name="InProgressItemsControl"
                                          ItemsSource="{Binding InProgressTasks}"
                                          ItemTemplate="{StaticResource TaskTemplate}"
                                          dd:DragDrop.IsDragSource="True"
                                          dd:DragDrop.UseDefaultDragAdorner="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Done -->
            <Border x:Name="DoneColumn" Grid.Column="2" Style="{StaticResource ColumnChrome}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ColumnHeaderHost}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource VsCodeStripeDone}"/>
                            <DockPanel Grid.Column="1" Margin="10,8,6,8" LastChildFill="True">
                                <TextBlock Text="{Binding DoneTasks.Count}" DockPanel.Dock="Right"
                                           Foreground="{StaticResource VsCodeForegroundMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Button Command="{Binding ClearDoneColumnCommand}" DockPanel.Dock="Right"
                                        Style="{StaticResource VsCodeIconButton}" ToolTip="Очистить колонку"
                                        Visibility="{Binding CanModifyTasks, Converter={StaticResource BoolToVis}}">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                </Button>
                                <TextBlock Text="Готово" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="Transparent"
                            AllowDrop="True"
                            dd:DragDrop.IsDropTarget="True"
                            dd:DragDrop.DropHandler="{Binding DropHandler}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,0">
                            <ItemsControl x:Name="DoneItemsControl"
                                          ItemsSource="{Binding DoneTasks}"
                                          ItemTemplate="{StaticResource TaskTemplate}"
                                          dd:DragDrop.IsDragSource="True"
                                          dd:DragDrop.UseDefaultDragAdorner="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status / actions strip -->
        <Border Grid.Row="2"
                Background="{StaticResource VsCodeTitleBarBg}"
                BorderBrush="{StaticResource VsCodeBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="8,6">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="Перетаскивайте карточки между колонками для смены статуса."
                           Foreground="{StaticResource VsCodeForegroundMuted}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Visibility="{Binding CanModifyTasks, Converter={StaticResource BoolToVis}}"/>
                <TextBlock DockPanel.Dock="Left"
                           Text="Вы участник организации: статус задач меняется только перетаскиванием. Создание и правка карточек недоступны."
                           Foreground="{StaticResource VsCodeForegroundMuted}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowParticipantBoardHint, Converter={StaticResource BoolToVis}}"/>
                <Button DockPanel.Dock="Right"
                        Content="Очистить все колонки"
                        Command="{Binding ClearAllColumnsCommand}"
                        Style="{StaticResource VsCodeSecondaryButton}"
                        ToolTip="Удалит задачи в текущей области (личные или команда)"
                        Visibility="{Binding CanModifyTasks, Converter={StaticResource BoolToVis}}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
