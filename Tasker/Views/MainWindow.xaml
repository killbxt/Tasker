<Window x:Class="TaskManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:dd="urn:gong-wpf-dragdrop"
        Title="Task Manager" Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        AllowsTransparency="False">

    <Window.Resources>
        <Style x:Key="ColumnStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="0,0,0,16"/>
        </Style>

        <DataTemplate x:Key="TaskTemplate">
            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                    CornerRadius="8"
                    Margin="8"
                    Padding="12"
                    BorderBrush="{Binding PriorityColor}"
                    BorderThickness="0,0,0,3">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding Title}" 
                                   FontWeight="Bold" FontSize="14"
                                   TextWrapping="Wrap"/>
                    </DockPanel>

                    <TextBlock Text="{Binding Description}" 
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Margin="0,8,0,8"
                               MaxHeight="60"/>

                    <Border Background="{DynamicResource MaterialDesignDivider}" 
                            Height="1" Margin="0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <materialDesign:PackIcon Kind="CalendarClock" Width="14" Height="14"/>
                        <TextBlock Text="{Binding PlannedWindowText}" 
                                   FontSize="11" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Width="30" Height="30"
                                Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignToolButton}">
                            <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                        </Button>
                        <Button Width="30" Height="30"
                                Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignToolButton}">
                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель - адаптивная -->
        <Border Grid.Row="0" Background="{DynamicResource MaterialDesignPaper}">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ViewDashboard" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="Менеджер задач" FontSize="18" FontWeight="Bold" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Центр - поиск и фильтры -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding TeamFilters}"
                              SelectedItem="{Binding SelectedTeamFilter}"
                              DisplayMemberPath="Name"
                              Width="160"
                              materialDesign:HintAssist.Hint="Команда"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"/>

                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Поиск..."
                             Width="180"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             VerticalAlignment="Center"/>
                </WrapPanel>

                <!-- Действия -->
                <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
                    <Button Command="{Binding AddTaskCommand}"
                            ToolTip="Новая задача"
                            Width="36" Height="36"
                            Margin="0,0,4,0"
                            Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                    </Button>

                    <Button Command="{Binding OpenProfileCommand}"
                            ToolTip="Профиль"
                            Width="36" Height="36"
                            Margin="0,0,4,0"
                            Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="AccountCircle" Width="20" Height="20"/>
                    </Button>

                    <Button Command="{Binding OpenAnalyticsCommand}"
                            ToolTip="Аналитика"
                            Width="36" Height="36"
                            Margin="0,0,4,0"
                            Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20"/>
                    </Button>

                    <Button Command="{Binding ManageTeamsCommand}"
                            ToolTip="Команды"
                            Width="36" Height="36"
                            Margin="0,0,4,0"
                            Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20"/>
                    </Button>

                    <Button Command="{Binding OpenAIChatCommand}"
                            ToolTip="AI помощник"
                            Width="36" Height="36"
                            Margin="0,0,4,0"
                            Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="Robot" Width="20" Height="20"/>
                    </Button>

                    <Button Command="{Binding LogoutCommand}"
                            ToolTip="Выйти"
                            Width="36" Height="36"
                            Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="Logout" Width="20" Height="20"/>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Канбан доска -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Колонка TODO -->
            <!-- Колонка TODO -->
            <Border x:Name="TodoColumn" Grid.Column="0" Style="{StaticResource ColumnStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FF5722" CornerRadius="12,12,0,0" Padding="12,8">
                        <DockPanel>
                            <TextBlock Text="Нужно сделать" FontWeight="Bold" FontSize="14" DockPanel.Dock="Left"/>
                            <Button Command="{Binding ClearTodoColumnCommand}" DockPanel.Dock="Right" Style="{StaticResource MaterialDesignToolButton}" ToolTip="Очистить колонку">
                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                            </Button>
                            <TextBlock Text="{Binding TodoTasks.Count}" DockPanel.Dock="Right" Margin="8,0,8,0"/>
                        </DockPanel>
                    </Border>

                    <!-- Добавляем Border как контейнер для Drop зоны -->
                    <Border Grid.Row="1" 
                Background="Transparent"
                AllowDrop="True"
                dd:DragDrop.IsDropTarget="True"
                dd:DragDrop.DropHandler="{Binding DropHandler}">
                        <ScrollViewer>
                            <ItemsControl x:Name="TodoItemsControl"
                            ItemsSource="{Binding TodoTasks}"
                            ItemTemplate="{StaticResource TaskTemplate}"
                            dd:DragDrop.IsDragSource="True"
                            dd:DragDrop.UseDefaultDragAdorner="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Колонка IN PROGRESS -->
            <Border x:Name="InProgressColumn" Grid.Column="1" Style="{StaticResource ColumnStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2196F3" CornerRadius="12,12,0,0" Padding="12,8">
                        <DockPanel>
                            <TextBlock Text="В работе" FontWeight="Bold" FontSize="14" DockPanel.Dock="Left"/>
                            <Button Command="{Binding ClearInProgressColumnCommand}" DockPanel.Dock="Right" Style="{StaticResource MaterialDesignToolButton}" ToolTip="Очистить колонку">
                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                            </Button>
                            <TextBlock Text="{Binding InProgressTasks.Count}" DockPanel.Dock="Right" Margin="8,0,8,0"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" 
                Background="Transparent"
                AllowDrop="True"
                dd:DragDrop.IsDropTarget="True"
                dd:DragDrop.DropHandler="{Binding DropHandler}">
                        <ScrollViewer>
                            <ItemsControl x:Name="InProgressItemsControl"
                            ItemsSource="{Binding InProgressTasks}"
                            ItemTemplate="{StaticResource TaskTemplate}"
                            dd:DragDrop.IsDragSource="True"
                            dd:DragDrop.UseDefaultDragAdorner="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Колонка DONE -->
            <Border x:Name="DoneColumn" Grid.Column="2" Style="{StaticResource ColumnStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#4CAF50" CornerRadius="12,12,0,0" Padding="12,8">
                        <DockPanel>
                            <TextBlock Text="Готово" FontWeight="Bold" FontSize="14" DockPanel.Dock="Left"/>
                            <Button Command="{Binding ClearDoneColumnCommand}" DockPanel.Dock="Right" Style="{StaticResource MaterialDesignToolButton}" ToolTip="Очистить колонку">
                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                            </Button>
                            <TextBlock Text="{Binding DoneTasks.Count}" DockPanel.Dock="Right" Margin="8,0,8,0"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" 
                Background="Transparent"
                AllowDrop="True"
                dd:DragDrop.IsDropTarget="True"
                dd:DragDrop.DropHandler="{Binding DropHandler}">
                        <ScrollViewer>
                            <ItemsControl x:Name="DoneItemsControl"
                            ItemsSource="{Binding DoneTasks}"
                            ItemTemplate="{StaticResource TaskTemplate}"
                            dd:DragDrop.IsDragSource="True"
                            dd:DragDrop.UseDefaultDragAdorner="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Button Content="Очистить всё"
                Command="{Binding ClearAllColumnsCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="1001,0,0,0"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                Height="36"
                ToolTip="Очистить все колонки"/>
    </Grid>
</Window>