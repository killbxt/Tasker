<Window x:Class="TaskManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:dd="urn:gong-wpf-dragdrop"
        Title="Tasker" Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        AllowsTransparency="False">

    <Window.Resources>
        <Style x:Key="ColumnChrome" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource VsCodeSidebarBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VsCodeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Margin" Value="4,6"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="ColumnHeaderHost" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource VsCodePanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VsCodeBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <DataTemplate x:Key="TaskTemplate">
            <Border Background="{StaticResource VsCodePanelBg}"
                    BorderBrush="{StaticResource VsCodeBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Margin="6,4"
                    Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{Binding PriorityColor}" VerticalAlignment="Stretch"/>
                    <StackPanel Grid.Column="1" Margin="10,8,10,8">
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding Description}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource VsCodeForegroundMuted}"
                                   Margin="0,6,0,0"
                                   MaxHeight="60"/>

                        <Border Background="{StaticResource VsCodeBorder}" Height="1" Margin="0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <materialDesign:PackIcon Kind="CalendarClock" Width="14" Height="14"
                                                     Foreground="{StaticResource VsCodeForegroundMuted}"/>
                            <TextBlock Text="{Binding PlannedWindowText}"
                                       FontSize="12"
                                       Foreground="{StaticResource VsCodeForegroundMuted}"
                                       Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource VsCodeIconButton}"
                                    ToolTip="Изменить">
                                <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"/>
                            </Button>
                            <Button Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource VsCodeIconButton}"
                                    ToolTip="Удалить">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource VsCodeEditorBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- VS Code-style top bar -->
        <Border Grid.Row="0" Style="{StaticResource VsCodeTitleBarBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ViewDashboard" Width="18" Height="18"
                                             Foreground="{StaticResource VsCodeAccentBlue}"/>
                    <TextBlock Text="Tasker" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding TeamFilters}"
                              SelectedItem="{Binding SelectedTeamFilter}"
                              DisplayMemberPath="Name"
                              Width="200"
                              materialDesign:HintAssist.Hint="Область"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"/>

                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Поиск (Ctrl+F в будущем)"
                             Width="260"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding AddTaskCommand}" ToolTip="Новая задача" Style="{StaticResource VsCodeIconButton}">
                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding OpenProfileCommand}" ToolTip="Профиль" Style="{StaticResource VsCodeIconButton}">
                        <materialDesign:PackIcon Kind="AccountOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding OpenAnalyticsCommand}" ToolTip="Аналитика" Style="{StaticResource VsCodeIconButton}">
                        <materialDesign:PackIcon Kind="ChartBar" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding ManageTeamsCommand}" ToolTip="Команды и организация" Style="{StaticResource VsCodeIconButton}">
                        <materialDesign:PackIcon Kind="AccountGroupOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding OpenAIChatCommand}" ToolTip="AI помощник" Style="{StaticResource VsCodeIconButton}">
                        <materialDesign:PackIcon Kind="RobotOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding LogoutCommand}" ToolTip="Выйти" Style="{StaticResource VsCodeIconButton}">
                        <materialDesign:PackIcon Kind="Logout" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Kanban -->
        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TODO -->
            <Border x:Name="TodoColumn" Grid.Column="0" Style="{StaticResource ColumnChrome}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ColumnHeaderHost}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource VsCodeStripeTodo}"/>
                            <DockPanel Grid.Column="1" Margin="10,8,6,8" LastChildFill="True">
                                <TextBlock Text="{Binding TodoTasks.Count}" DockPanel.Dock="Right"
                                           Foreground="{StaticResource VsCodeForegroundMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Button Command="{Binding ClearTodoColumnCommand}" DockPanel.Dock="Right"
                                        Style="{StaticResource VsCodeIconButton}" ToolTip="Очистить колонку">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                </Button>
                                <TextBlock Text="Нужно сделать" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="Transparent"
                            AllowDrop="True"
                            dd:DragDrop.IsDropTarget="True"
                            dd:DragDrop.DropHandler="{Binding DropHandler}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,0">
                            <ItemsControl x:Name="TodoItemsControl"
                                          ItemsSource="{Binding TodoTasks}"
                                          ItemTemplate="{StaticResource TaskTemplate}"
                                          dd:DragDrop.IsDragSource="True"
                                          dd:DragDrop.UseDefaultDragAdorner="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- In progress -->
            <Border x:Name="InProgressColumn" Grid.Column="1" Style="{StaticResource ColumnChrome}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ColumnHeaderHost}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource VsCodeStripeProgress}"/>
                            <DockPanel Grid.Column="1" Margin="10,8,6,8" LastChildFill="True">
                                <TextBlock Text="{Binding InProgressTasks.Count}" DockPanel.Dock="Right"
                                           Foreground="{StaticResource VsCodeForegroundMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Button Command="{Binding ClearInProgressColumnCommand}" DockPanel.Dock="Right"
                                        Style="{StaticResource VsCodeIconButton}" ToolTip="Очистить колонку">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                </Button>
                                <TextBlock Text="В работе" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="Transparent"
                            AllowDrop="True"
                            dd:DragDrop.IsDropTarget="True"
                            dd:DragDrop.DropHandler="{Binding DropHandler}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,0">
                            <ItemsControl x:Name="InProgressItemsControl"
                                          ItemsSource="{Binding InProgressTasks}"
                                          ItemTemplate="{StaticResource TaskTemplate}"
                                          dd:DragDrop.IsDragSource="True"
                                          dd:DragDrop.UseDefaultDragAdorner="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Done -->
            <Border x:Name="DoneColumn" Grid.Column="2" Style="{StaticResource ColumnChrome}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ColumnHeaderHost}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource VsCodeStripeDone}"/>
                            <DockPanel Grid.Column="1" Margin="10,8,6,8" LastChildFill="True">
                                <TextBlock Text="{Binding DoneTasks.Count}" DockPanel.Dock="Right"
                                           Foreground="{StaticResource VsCodeForegroundMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Button Command="{Binding ClearDoneColumnCommand}" DockPanel.Dock="Right"
                                        Style="{StaticResource VsCodeIconButton}" ToolTip="Очистить колонку">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                </Button>
                                <TextBlock Text="Готово" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="Transparent"
                            AllowDrop="True"
                            dd:DragDrop.IsDropTarget="True"
                            dd:DragDrop.DropHandler="{Binding DropHandler}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,0">
                            <ItemsControl x:Name="DoneItemsControl"
                                          ItemsSource="{Binding DoneTasks}"
                                          ItemTemplate="{StaticResource TaskTemplate}"
                                          dd:DragDrop.IsDragSource="True"
                                          dd:DragDrop.UseDefaultDragAdorner="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status / actions strip -->
        <Border Grid.Row="2"
                Background="{StaticResource VsCodeTitleBarBg}"
                BorderBrush="{StaticResource VsCodeBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="8,6">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="Перетаскивайте карточки между колонками для смены статуса."
                           Foreground="{StaticResource VsCodeForegroundMuted}"
                           VerticalAlignment="Center"
                           FontSize="12"/>
                <Button DockPanel.Dock="Right"
                        Content="Очистить все колонки"
                        Command="{Binding ClearAllColumnsCommand}"
                        Style="{StaticResource VsCodeSecondaryButton}"
                        ToolTip="Удалит задачи в текущей области (личные или команда)"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
