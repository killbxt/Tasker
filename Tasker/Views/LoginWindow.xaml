<Window x:Class="TaskManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Task Manager - Вход" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                <GradientStop Color="#FFDEE9" Offset="0"/>
                <GradientStop Color="#B5FFFC" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Width="400" VerticalAlignment="Center">
            <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                    CornerRadius="16" Padding="32">
                <StackPanel>
                    <materialDesign:PackIcon Kind="ViewDashboard" 
                                           Width="64" Height="64" 
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                           HorizontalAlignment="Center"/>

                    <TextBlock Text="Менеджер задач" 
                               FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,30"/>

                    <TextBox x:Name="EmailTextBox" 
                             materialDesign:HintAssist.Hint="Email"
                             Margin="0,0,0,16"
                             Style="{StaticResource MaterialDesignFilledTextBox}"/>

                    <PasswordBox x:Name="PasswordBox" 
                                 materialDesign:HintAssist.Hint="Пароль"
                                 Margin="0,0,0,24"
                                 Style="{StaticResource MaterialDesignFilledPasswordBox}"/>

                    <Button Content="Войти" 
                            Click="LoginButton_Click"
                            Margin="0,0,0,12"
                            Height="40"/>

                    <Button Content="Регистрация" 
                            Click="RegisterButton_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="40"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>