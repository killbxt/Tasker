<Window x:Class="TaskManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:TaskManager.Controls"
        Title="Tasker — вход" Height="520" Width="880"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource TaskerChromeWindow}">

    <Grid Margin="{StaticResource AppPadHalfRem}" Background="{StaticResource VsCodeEditorBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" TitleText="Tasker — вход"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" VerticalAlignment="Center" Margin="0,8,0,8">
                <Border Background="{StaticResource VsCodeSidebarBg}"
                        BorderBrush="{StaticResource VsCodeBorder}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="8,8,8,8">
                    <StackPanel Margin="8,8,8,10">
                        <TextBlock Text="Вход" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Войдите в аккаунт, чтобы открыть доску задач."
                                   FontSize="12"
                                   Foreground="{StaticResource VsCodeForegroundMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <TextBox x:Name="EmailTextBox"
                                 materialDesign:HintAssist.Hint="Email"
                                 Margin="0,0,0,10"/>

                        <PasswordBox x:Name="PasswordBox"
                                     materialDesign:HintAssist.Hint="Пароль"
                                     Margin="0,0,0,18"/>

                        <Button Content="Войти"
                                Click="LoginButton_Click"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource VsCodePrimaryButton}"/>

                        <Button Content="Создать аккаунт"
                                Click="RegisterButton_Click"
                                Style="{StaticResource VsCodeSecondaryButton}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
