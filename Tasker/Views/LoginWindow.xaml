<Window x:Class="TaskManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Tasker — вход" Height="520" Width="880"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Background="{StaticResource VsCodeEditorBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="1" VerticalAlignment="Center">
            <Border Background="{StaticResource VsCodeSidebarBg}"
                    BorderBrush="{StaticResource VsCodeBorder}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource VsCodeTitleBarBorder}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MicrosoftVisualStudioCode" Width="20" Height="20"
                                                     Foreground="{StaticResource VsCodeAccentBlue}"/>
                            <TextBlock Text="Tasker" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="20,20,20,24">
                        <TextBlock Text="Вход" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Тот же тёмный тон, что и в VS Code." FontSize="12"
                                   Foreground="{StaticResource VsCodeForegroundMuted}" Margin="0,0,0,18"/>

                        <TextBox x:Name="EmailTextBox"
                                 materialDesign:HintAssist.Hint="Email"
                                 Margin="0,0,0,10"/>

                        <PasswordBox x:Name="PasswordBox"
                                     materialDesign:HintAssist.Hint="Пароль"
                                     Margin="0,0,0,18"/>

                        <Button Content="Войти"
                                Click="LoginButton_Click"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource VsCodePrimaryButton}"/>

                        <Button Content="Создать аккаунт"
                                Click="RegisterButton_Click"
                                Style="{StaticResource VsCodeSecondaryButton}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
