<Window x:Class="TaskManager.Views.ManageTeamsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:TaskManager.Controls"
        Title="Организация и команды" Height="720" Width="820"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource TaskerChromeWindow}"
        MinHeight="560" MinWidth="640">

    <Grid Margin="{StaticResource AppPadHalfRem}" Background="{StaticResource VsCodeEditorBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" TitleText="Организация и команды"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource AppPanelStyle}" Margin="0,8,0,10">
                <StackPanel>
                    <TextBlock Text="Как это устроено" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource VsCodeForegroundMuted}" LineHeight="20">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource VsCodeForeground}">Организация</Run>
                        <Run> — общее «место», куда входят люди. Без организации команды создать нельзя.</Run>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{StaticResource VsCodeForeground}">Команда</Run>
                        <Run> — группа внутри организации. Задачи команды видны по правилам владельца и участников.</Run>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{StaticResource VsCodeForeground}">Личные задачи</Run>
                        <Run> — на доске без привязки к команде; выбираются вверху на главном экране.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="1"
                        Margin="0,0,0,8"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0">
                <TabItem Header="1. Моя организация">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,8">
                        <StackPanel>
                            <Border x:Name="NoOrgPanel" Style="{StaticResource AppPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="У вас пока нет организации" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource VsCodeForegroundMuted}" Margin="0,0,0,16"
                                               Text="Нажмите кнопку ниже, придумайте название — и можно создавать команды и звать людей."/>
                                    <Button x:Name="CreateOrgButton" Content="Создать организацию"
                                            Click="CreateOrganization_Click"
                                            Style="{StaticResource VsCodePrimaryButton}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="HasOrgPanel" Style="{StaticResource AppPanelStyle}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Текущая организация" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="OrganizationInfoText" Foreground="{StaticResource VsCodeForegroundMuted}"
                                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                                    <StackPanel x:Name="OrgViewPanel" Orientation="Vertical">
                                        <TextBlock x:Name="OrgNameDisplay" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock x:Name="OrgDescDisplay" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Foreground="{StaticResource VsCodeForegroundMuted}"/>
                                    </StackPanel>

                                    <StackPanel x:Name="OrgEditPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                        <TextBox x:Name="OrgNameEditBox" materialDesign:HintAssist.Hint="Название организации" Margin="0,0,0,10"/>
                                        <TextBox x:Name="OrgDescEditBox" materialDesign:HintAssist.Hint="Описание"
                                                 TextWrapping="Wrap" Height="72" AcceptsReturn="True" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Сохранить" Click="SaveOrganizationEdit_Click"
                                                    Style="{StaticResource VsCodePrimaryButton}" Margin="0,0,8,0"/>
                                            <Button Content="Отмена" Click="CancelOrganizationEdit_Click"
                                                    Style="{StaticResource VsCodeSecondaryButton}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <WrapPanel Margin="0,16,0,0" Orientation="Horizontal">
                                        <Button x:Name="EditOrgButton" Content="Изменить название и описание"
                                                Click="StartEditOrganization_Click"
                                                Style="{StaticResource VsCodeSecondaryButton}" Margin="0,0,8,8"/>
                                        <Button x:Name="ManageMembersButton" Content="Участники организации →"
                                                Click="ManageMembers_Click"
                                                Style="{StaticResource VsCodePrimaryButton}" Margin="0,0,8,8"/>
                                        <Button x:Name="DeleteOrgButton" Content="Удалить организацию…"
                                                Click="DeleteOrganization_Click"
                                                Style="{StaticResource VsCodeSecondaryButton}" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="2. Команды">
                    <Grid Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="240"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*" MinWidth="260"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="Ваши команды" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ListBox x:Name="TeamsListBox"
                                     Style="{StaticResource StretchListBox}"
                                     SelectionChanged="TeamsListBox_SelectionChanged"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource VsCodeBorder}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,12"
                                                HorizontalAlignment="Stretch"
                                                Background="{StaticResource VsCodePanelBg}"
                                                BorderBrush="{StaticResource VsCodeBorder}"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{StaticResource VsCodeForegroundMuted}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <Border Grid.Column="2" Style="{StaticResource AppPanelStyle}" VerticalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Выбранная команда" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock x:Name="TeamPickHint" Text="Выберите команду слева или создайте новую ниже."
                                           TextWrapping="Wrap" Foreground="{StaticResource VsCodeForegroundMuted}" Margin="0,0,0,12"/>

                                <StackPanel x:Name="TeamDetailPanel" Visibility="Collapsed">
                                    <TextBox x:Name="SelectedTeamNameBox" materialDesign:HintAssist.Hint="Название" Margin="0,0,0,8"/>
                                    <TextBox x:Name="SelectedTeamDescBox" materialDesign:HintAssist.Hint="Описание"
                                             TextWrapping="Wrap" Height="72" AcceptsReturn="True" Margin="0,0,0,12"/>
                                    <Button x:Name="SaveTeamButton" Content="Сохранить изменения" Click="SaveTeam_Click"
                                            Style="{StaticResource VsCodePrimaryButton}" Margin="0,0,0,8"/>
                                    <Button x:Name="DeleteTeamButton" Content="Удалить команду…" Click="DeleteTeam_Click"
                                            Style="{StaticResource VsCodeSecondaryButton}"/>
                                    <TextBlock x:Name="TeamOwnerHint" TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource VsCodeForegroundMuted}" Margin="0,12,0,0"/>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource VsCodeBorder}" Margin="0,8,0,16"/>

                                <TextBlock Text="Новая команда" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="Сначала должна быть организация (вкладка слева)." TextWrapping="Wrap"
                                           Foreground="{StaticResource VsCodeForegroundMuted}" Margin="0,0,0,12"/>
                                <TextBox x:Name="TeamNameTextBox" materialDesign:HintAssist.Hint="Название команды" Margin="0,0,0,8"/>
                                <TextBox x:Name="TeamDescTextBox" materialDesign:HintAssist.Hint="Описание (необязательно)"
                                         TextWrapping="Wrap" Height="56" AcceptsReturn="True" Margin="0,0,0,12"/>
                                <Button Content="Создать команду" Click="CreateTeam_Click"
                                        Style="{StaticResource VsCodePrimaryButton}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="3. Люди">
                    <StackPanel Margin="0,12,0,8">
                        <Border Style="{StaticResource AppPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Участники" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource VsCodeForegroundMuted}" Margin="0,0,0,16"
                                           Text="Добавляйте коллег по email (они уже должны быть зарегистрированы). Можно сразу указать команду."/>
                                <Button Content="Открыть список участников и приглашения"
                                        Click="ManageMembersFromTab_Click"
                                        Style="{StaticResource VsCodePrimaryButton}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource VsCodeTitleBarBg}"
                BorderBrush="{StaticResource VsCodeBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="8,10"
                Margin="0,4,0,0">
            <Button Content="Готово"
                    Click="CloseButton_Click"
                    HorizontalAlignment="Right"
                    Style="{StaticResource VsCodePrimaryButton}"/>
        </Border>
    </Grid>
</Window>
