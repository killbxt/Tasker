<Window x:Class="TaskManager.Views.AnalyticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:TaskManager.Controls"
        Title="Аналитика" Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource TaskerChromeWindow}">

    <Grid Margin="{StaticResource AppPadHalfRem}" Background="{StaticResource VsCodeEditorBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" TitleText="Аналитика"/>

        <TextBlock x:Name="ScopeTitle"
                   Grid.Row="1"
                   Margin="0,6,0,10"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>

        <UniformGrid Grid.Row="2" Rows="1" Columns="3">
            <Border Style="{StaticResource AppPanelStyle}" Margin="0,0,8,10">
                <StackPanel>
                    <TextBlock Text="Закрыто всего" Foreground="{StaticResource VsCodeForegroundMuted}" FontSize="12"/>
                    <TextBlock x:Name="TotalDoneText" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AppPanelStyle}" Margin="0,0,8,10">
                <StackPanel>
                    <TextBlock Text="За 7 дней" Foreground="{StaticResource VsCodeForegroundMuted}" FontSize="12"/>
                    <TextBlock x:Name="Done7DaysText" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AppPanelStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Среднее время" Foreground="{StaticResource VsCodeForegroundMuted}" FontSize="12"/>
                    <TextBlock x:Name="AvgLeadTimeText" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource AppPanelStyle}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Топ исполнителей (закрыто)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ItemsControl x:Name="TopAssigneesList" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource VsCodeBorder}" BorderThickness="0,0,0,1" Padding="0,8"
                                    HorizontalAlignment="Stretch">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="{Binding Count}" DockPanel.Dock="Right" FontWeight="SemiBold"
                                               Foreground="{StaticResource VsCodeAccentBlue}" Margin="12,0,0,0"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Background="{StaticResource VsCodeTitleBarBg}"
                BorderBrush="{StaticResource VsCodeBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="8,10"
                Margin="0,4,0,0">
            <Button Content="Закрыть"
                    Click="Close_Click"
                    HorizontalAlignment="Right"
                    Style="{StaticResource VsCodePrimaryButton}"/>
        </Border>
    </Grid>
</Window>
