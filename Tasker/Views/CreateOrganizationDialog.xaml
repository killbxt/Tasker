<Window x:Class="TaskManager.Views.CreateOrganizationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Создание организации" Height="350" Width="500"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🏢 Создание организации" 
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <TextBox x:Name="OrgNameTextBox" 
                 Grid.Row="1"
                 materialDesign:HintAssist.Hint="Название организации"
                 Margin="0,0,0,16"/>

        <TextBox x:Name="OrgDescTextBox" 
                 Grid.Row="2"
                 materialDesign:HintAssist.Hint="Описание организации"
                 TextWrapping="Wrap"
                 Height="80"
                 AcceptsReturn="True"
                 Margin="0,0,0,24"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    Click="CancelButton_Click"
                    Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="Создать" 
                    Click="CreateButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>