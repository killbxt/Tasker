<Window x:Class="TaskManager.Views.CreateOrganizationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:TaskManager.Controls"
        Title="Новая организация" Height="380" Width="520"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource TaskerChromeWindow}">

    <Grid Margin="{StaticResource AppPadHalfRem}" Background="{StaticResource VsCodeEditorBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" TitleText="Создание организации"/>

        <StackPanel Grid.Row="1" Margin="0,10,0,10">
            <TextBox x:Name="OrgNameTextBox"
                     materialDesign:HintAssist.Hint="Название"
                     Margin="0,0,0,12"/>
            <TextBox x:Name="OrgDescTextBox"
                     materialDesign:HintAssist.Hint="Описание"
                     TextWrapping="Wrap"
                     Height="96"
                     AcceptsReturn="True"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{StaticResource VsCodeTitleBarBg}"
                BorderBrush="{StaticResource VsCodeBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="8,10"
                Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Click="CancelButton_Click"
                        Margin="0,0,8,0"
                        Style="{StaticResource VsCodeSecondaryButton}"/>
                <Button Content="Создать"
                        Click="CreateButton_Click"
                        Style="{StaticResource VsCodePrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
