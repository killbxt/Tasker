<Window x:Class="TaskManager.Views.TaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Задача" Height="640" Width="520"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Создание/Редактирование задачи" 
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <TextBox Grid.Row="1" x:Name="TitleTextBox" 
                 materialDesign:HintAssist.Hint="Название задачи"
                 Margin="0,0,0,12"/>

        <TextBox Grid.Row="2" x:Name="DescriptionTextBox" 
                 materialDesign:HintAssist.Hint="Описание"
                 TextWrapping="Wrap"
                 Height="100"
                 AcceptsReturn="True"
                 Margin="0,0,0,12"/>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DatePicker Grid.Column="0" x:Name="StartDatePicker"
                        materialDesign:HintAssist.Hint="Начало (дата)"
                        Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="StartTimeTextBox"
                     materialDesign:HintAssist.Hint="HH:mm"
                     Width="80"
                     VerticalContentAlignment="Center"
                     Margin="0,0,12,0"/>

            <DatePicker Grid.Column="2" x:Name="EndDatePicker"
                        materialDesign:HintAssist.Hint="Окончание (дата)"/>
            <TextBox Grid.Column="3" x:Name="EndTimeTextBox"
                     materialDesign:HintAssist.Hint="HH:mm"
                     Width="80"
                     VerticalContentAlignment="Center"
                     Margin="8,0,0,0"/>
        </Grid>

        <ComboBox Grid.Row="4" x:Name="PriorityComboBox" 
                  Margin="0,0,0,12">
            <ComboBoxItem Content="Обычная" Tag="Normal"/>
            <ComboBoxItem Content="Срочно" Tag="Urgent"/>
        </ComboBox>

        <ComboBox Grid.Row="5" x:Name="TeamComboBox" 
                  DisplayMemberPath="Name"
                  materialDesign:HintAssist.Hint="Команда (опционально)"
                  Margin="0,0,0,12"/>

        <ComboBox Grid.Row="6" x:Name="AssigneeComboBox"
                  DisplayMemberPath="Username"
                  materialDesign:HintAssist.Hint="Исполнитель (опционально)"
                  Margin="0,0,0,12"/>

        <ComboBox Grid.Row="7" x:Name="StatusComboBox" 
                  Margin="0,0,0,24">
            <ComboBoxItem Content="Нужно сделать" Tag="Todo"/>
            <ComboBoxItem Content="В работе" Tag="InProgress"/>
            <ComboBoxItem Content="Готово" Tag="Done"/>
        </ComboBox>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    Click="CancelButton_Click"
                    Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="Сохранить" 
                    Click="SaveButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>