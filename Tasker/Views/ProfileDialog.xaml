<Window x:Class="TaskManager.Views.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Профиль" Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Background="{StaticResource VsCodeEditorBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource VsCodeTitleBarBorder}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AccountOutline" Width="18" Height="18"
                                         Foreground="{StaticResource VsCodeAccentBlue}"/>
                <TextBlock Text="Профиль" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AppPanelStyle}" Margin="12,12,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="UsernameText" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="EmailText" Foreground="{StaticResource VsCodeForegroundMuted}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="OrgText" Foreground="{StaticResource VsCodeForegroundMuted}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button ToolTip="Новая личная задача"
                            Click="AddTask_Click"
                            Style="{StaticResource VsCodeIconButton}"
                            Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                    </Button>
                    <Button ToolTip="Обновить"
                            Click="Refresh_Click"
                            Style="{StaticResource VsCodeIconButton}">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  x:Name="TasksGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="12,12,12,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Сроки" Binding="{Binding PlannedWindowText}" Width="*"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Background="{StaticResource VsCodeTitleBarBg}"
                BorderBrush="{StaticResource VsCodeBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Редактировать"
                        Click="EditTask_Click"
                        Margin="0,0,8,0"
                        Style="{StaticResource VsCodeSecondaryButton}"/>
                <Button Content="Удалить"
                        Click="DeleteTask_Click"
                        Margin="0,0,8,0"
                        Style="{StaticResource VsCodeSecondaryButton}"/>
                <Button Content="Закрыть"
                        Click="Close_Click"
                        Style="{StaticResource VsCodePrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
