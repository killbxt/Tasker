<Window x:Class="TaskManager.Views.JoinTeamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Вступить в команду" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Доступные команды" 
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <ListBox Grid.Row="1" x:Name="AvailableTeamsListBox" 
                 Margin="0,0,0,16">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding Description}" FontSize="11" 
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="{Binding Organization.Name}" FontSize="10" 
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    Click="CancelButton_Click"
                    Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="Вступить" 
                    Click="JoinButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>