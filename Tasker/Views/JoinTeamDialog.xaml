<Window x:Class="TaskManager.Views.JoinTeamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:TaskManager.Controls"
        Title="Вступить в команду" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource TaskerChromeWindow}">

    <Grid Margin="{StaticResource AppPadHalfRem}" Background="{StaticResource VsCodeEditorBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" TitleText="Доступные команды"/>

        <ListBox Grid.Row="1"
                 x:Name="AvailableTeamsListBox"
                 Style="{StaticResource StretchListBox}"
                 Margin="0,8,0,8"
                 BorderThickness="1"
                 BorderBrush="{StaticResource VsCodeBorder}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,10"
                            HorizontalAlignment="Stretch"
                            Background="{StaticResource VsCodePanelBg}"
                            BorderBrush="{StaticResource VsCodeBorder}"
                            BorderThickness="1"
                            CornerRadius="2">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" FontSize="12"
                                       Foreground="{StaticResource VsCodeForegroundMuted}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Organization.Name}" FontSize="12"
                                       Foreground="{StaticResource VsCodeAccentBlue}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Background="{StaticResource VsCodeTitleBarBg}"
                BorderBrush="{StaticResource VsCodeBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="8,10"
                Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Click="CancelButton_Click"
                        Margin="0,0,8,0"
                        Style="{StaticResource VsCodeSecondaryButton}"/>
                <Button Content="Вступить"
                        Click="JoinButton_Click"
                        Style="{StaticResource VsCodePrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
