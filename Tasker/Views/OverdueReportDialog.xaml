<Window x:Class="TaskManager.Views.OverdueReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TaskManager.Controls"
        Title="Просрочки по командам" Height="520" Width="920"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource TaskerChromeWindow}"
        MinWidth="640" MinHeight="400">

    <Grid Margin="{StaticResource AppPadHalfRem}" Background="{StaticResource VsCodeEditorBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" TitleText="Просрочки (для владельца команды)"/>

        <TextBlock Grid.Row="1"
                   x:Name="HintText"
                   Margin="0,8,0,10"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource VsCodeForegroundMuted}"
                   FontSize="12"/>

        <DataGrid Grid.Row="2"
                  x:Name="ReportGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Организация" Binding="{Binding OrganizationName}" Width="1.2*"/>
                <DataGridTextColumn Header="Команда" Binding="{Binding TeamName}" Width="*"/>
                <DataGridTextColumn Header="Задача" Binding="{Binding TaskTitle}" Width="2*"/>
                <DataGridTextColumn Header="Исполнитель" Binding="{Binding AssigneeName}" Width="*"/>
                <DataGridTextColumn Header="Срок" Binding="{Binding PlannedEndText}" Width="*"/>
                <DataGridTextColumn Header="Просрочено" Binding="{Binding OverdueText}" Width="0.8*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Background="{StaticResource VsCodeTitleBarBg}"
                BorderBrush="{StaticResource VsCodeBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="8,10"
                Margin="0,4,0,0">
            <Button Content="Закрыть"
                    Click="Close_Click"
                    HorizontalAlignment="Right"
                    Style="{StaticResource VsCodePrimaryButton}"/>
        </Border>
    </Grid>
</Window>
