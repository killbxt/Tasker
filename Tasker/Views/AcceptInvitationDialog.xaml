<Window x:Class="TaskManager.Views.AcceptInvitationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Приглашение" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:PackIcon Kind="Email" 
                               Width="27" Height="20"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="373,5,0,0"/>

        <TextBlock Text="Вам пришло приглашение!" 
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Left"
                   Margin="106,-2,0,10"/>

        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignPaper}" 
                CornerRadius="8" Padding="16" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock x:Name="InviteInfoText" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBox x:Name="TokenTextBox" 
                         materialDesign:HintAssist.Hint="Введите код приглашения"
                         Margin="0,16,0,0"
                         FontFamily="Consolas"
                         FontSize="14"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="❌ Отклонить" 
                    Click="DeclineButton_Click"
                    Margin="0,0,16,0"
                    Width="120" Height="40"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="✅ Принять" 
                    Click="AcceptButton_Click"
                    Width="120" Height="40"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>