<Window x:Class="TaskManager.Views.AIChatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="AI помощник" Height="600" Width="550"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppPanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="10" Padding="12" Margin="0,0,0,16">
            <DockPanel>
                <materialDesign:PackIcon Kind="Robot" Width="20" Height="20" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                <TextBlock Text="AI помощник" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer" 
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MessagesListBox">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8,4" 
                                HorizontalAlignment="{Binding Alignment}"
                                Background="{Binding BackgroundColor}"
                                CornerRadius="12"
                                Padding="12,8"
                                MaxWidth="400">
                            <TextBlock Text="{Binding Text}" 
                                       TextWrapping="Wrap"
                                       Foreground="White"
                                       FontSize="13"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MessageTextBox" 
                     materialDesign:HintAssist.Hint="Напишите сообщение..."
                     KeyDown="MessageTextBox_KeyDown"/>

            <Button Grid.Column="1" 
                    Content="Отправить"
                    Click="SendButton_Click"
                    Margin="8,0,0,0"
                    Width="100"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </Grid>
    </Grid>
</Window>