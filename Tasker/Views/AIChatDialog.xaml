<Window x:Class="TaskManager.Views.AIChatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:TaskManager.Controls"
        Title="AI помощник" Height="600" Width="550"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource TaskerChromeWindow}">

    <Grid Margin="{StaticResource AppPadHalfRem}" Background="{StaticResource VsCodeEditorBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" TitleText="AI помощник"/>

        <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,8,0,8"
                      Margin="0,4,0,0">
            <ItemsControl x:Name="MessagesListBox" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4"
                                HorizontalAlignment="{Binding Alignment}"
                                Background="{Binding BackgroundColor}"
                                BorderBrush="{StaticResource VsCodeBorder}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="10,8"
                                MaxWidth="420">
                            <TextBlock Text="{Binding Text}"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding ForegroundColor}"
                                       FontSize="13"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="0,8,0,0"
                Background="{StaticResource VsCodeTitleBarBg}"
                BorderBrush="{StaticResource VsCodeBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="8,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageTextBox"
                         materialDesign:HintAssist.Hint="Напишите сообщение..."
                         KeyDown="MessageTextBox_KeyDown"
                         VerticalContentAlignment="Center"
                         MinHeight="28"/>

                <Button Grid.Column="1"
                        Content="Отправить"
                        Click="SendButton_Click"
                        Margin="8,0,0,0"
                        MinWidth="96"
                        Style="{StaticResource VsCodePrimaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
