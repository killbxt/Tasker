<Window x:Class="TaskManager.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Task Manager - Регистрация" Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="1" Style="{StaticResource AppPanelStyle}" VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,18">
                    <materialDesign:PackIcon Kind="AccountPlus" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    <TextBlock Text="Tasker" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Регистрация" FontSize="24" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Создайте аккаунт для работы с задачами." Opacity="0.75" Margin="0,0,0,18"/>

                <TextBox x:Name="UsernameTextBox"
                         materialDesign:HintAssist.Hint="Имя пользователя"
                         Margin="0,0,0,12"/>

                <TextBox x:Name="EmailTextBox"
                         materialDesign:HintAssist.Hint="Email"
                         Margin="0,0,0,12"/>

                <PasswordBox x:Name="PasswordBox"
                             materialDesign:HintAssist.Hint="Пароль"
                             Margin="0,0,0,12"/>

                <PasswordBox x:Name="ConfirmPasswordBox"
                             materialDesign:HintAssist.Hint="Подтвердите пароль"
                             Margin="0,0,0,18"/>

                <Button Content="Создать аккаунт"
                        Click="RegisterButton_Click"
                        Margin="0,0,0,10"/>

                <Button Content="Назад ко входу"
                        Click="BackButton_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>