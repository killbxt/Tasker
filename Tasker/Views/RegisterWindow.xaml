<Window x:Class="TaskManager.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Task Manager - Регистрация" Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                <GradientStop Color="#1a1a2e" Offset="0"/>
                <GradientStop Color="#16213e" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Width="400" VerticalAlignment="Center">
            <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                    CornerRadius="16" Padding="32">
                <StackPanel>
                    <materialDesign:PackIcon Kind="AccountPlus" 
                                           Width="64" Height="64" 
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                           HorizontalAlignment="Center"/>

                    <TextBlock Text="Регистрация" 
                               FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,30"/>

                    <TextBox x:Name="UsernameTextBox" 
                             materialDesign:HintAssist.Hint="Имя пользователя"
                             Margin="0,0,0,16"
                             Style="{StaticResource MaterialDesignFilledTextBox}"/>

                    <TextBox x:Name="EmailTextBox" 
                             materialDesign:HintAssist.Hint="Email"
                             Margin="0,0,0,16"
                             Style="{StaticResource MaterialDesignFilledTextBox}"/>

                    <PasswordBox x:Name="PasswordBox" 
                                 materialDesign:HintAssist.Hint="Пароль"
                                 Margin="0,0,0,16"
                                 Style="{StaticResource MaterialDesignFilledPasswordBox}"/>

                    <PasswordBox x:Name="ConfirmPasswordBox" 
                                 materialDesign:HintAssist.Hint="Подтвердите пароль"
                                 Margin="0,0,0,24"
                                 Style="{StaticResource MaterialDesignFilledPasswordBox}"/>

                    <Button Content="Зарегистрироваться" 
                            Click="RegisterButton_Click"
                            Margin="0,0,0,12"
                            Height="40"/>

                    <Button Content="Назад к входу" 
                            Click="BackButton_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="40"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>